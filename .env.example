# Local/deployment configuration. Copy to .env only for tooling that loads it;
# Django reads these values from the process environment.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
LOGIN_REQUIRED=False

# Use PostgreSQL for shared or production deployments.
DATABASE_URL=postgresql://bankrisk:bankrisk@localhost:5432/bankrisk
DB_SSL_REQUIRE=False

SCORING_API_KEY=
AUDIT_HMAC_KEY=replace-with-a-separate-random-secret
API_RATE_LIMIT_PER_MINUTE=60
CASE_RETENTION_DAYS=365
MAX_BATCH_ROWS=1000
MAX_UPLOAD_BYTES=10485760

# Optional first production administrator. The bootstrap command creates the
# account only when both username and password are supplied.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
